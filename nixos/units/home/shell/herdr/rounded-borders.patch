+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum BorderStyleConfig {
+    #[default]
+    Plain,
+    Rounded,
+}
+
+impl BorderStyleConfig {
+    pub fn rounded(self) -> bool {
+        matches!(self, Self::Rounded)
+    }
+}
+
+impl<'de> Deserialize<'de> for BorderStyleConfig {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        struct BorderStyleVisitor;
+
+        impl<'de> de::Visitor<'de> for BorderStyleVisitor {
+            type Value = BorderStyleConfig;
+
+            fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
+                formatter.write_str("\"plain\" or \"rounded\"")
+            }
+
+            fn visit_str<E: de::Error>(self, value: &str) -> Result<Self::Value, E> {
+                match value {
+                    "plain" => Ok(BorderStyleConfig::Plain),
+                    "rounded" => Ok(BorderStyleConfig::Rounded),
+                    other => Err(E::invalid_value(de::Unexpected::Str(other), &self)),
+                }
+            }
+        }
+
+        deserializer.deserialize_str(BorderStyleVisitor)
+    }
+}
+
